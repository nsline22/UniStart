<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Theme"
        android:textSize="20sp"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/lightThemeButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/theme_selector"
            android:text="Light"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_margin="8dp" />

        <Button
            android:id="@+id/darkThemeButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/theme_selector"
            android:text="Dark"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_margin="8dp" />

        <Button
            android:id="@+id/materialThemeButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/theme_selector"
            android:text="Material"
            android:textColor="?attr/colorPrimary"
            android:gravity="center"
            android:layout_margin="8dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose your preferred app theme"
        android:textSize="14sp"
        android:textColor="@color/material_dynamic_primary60"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />
</LinearLayout>