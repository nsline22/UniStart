<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Верхний бар с иконками -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_dark"
        android:padding="5dp"
        android:elevation="4dp"
        android:outlineProvider="bounds"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            android:tint="?attr/colorPrimary"/>

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="UniStart"
            android:src="@drawable/ic_appic"
            android:scaleType="fitCenter"
            android:tint="?attr/colorPrimary"
            android:layout_marginBottom="10dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>

        <ImageButton
            android:id="@+id/logsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open Logs"
            android:scaleType="centerInside"
            android:src="@drawable/ic_visibility_off"
            android:tint="?attr/colorPrimary"/>

    </RelativeLayout>

    <!-- Основной контент -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="16dp">

                <!-- Панель подключения -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <!-- Connect Button Container -->
                    <LinearLayout
                        android:id="@+id/connectButton"
                        android:layout_width="200dp"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:background="@drawable/output_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/link"
                            android:tint="?attr/colorPrimary"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/connectButtonText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/connect"
                            android:textColor="@color/material_dynamic_primary60"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <!-- Unlock Button Container -->
                    <LinearLayout
                        android:id="@+id/buttonU"
                        android:layout_width="55dp"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:background="@drawable/output_background"
                        android:gravity="center"
                        android:layout_marginStart="3dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/un"
                            android:tint="?attr/colorPrimary"/>

                    </LinearLayout>

                    <View
                        android:id="@+id/connectionIndicator"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/connection_indicator" />

                </LinearLayout>

                <!-- Контейнер для времени и даты -->
                <LinearLayout
                    android:layout_width="308dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/output_background"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/timeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--:--"
                        android:textColor="@color/material_dynamic_primary60"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dateTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--/--"
                        android:textColor="@color/material_dynamic_primary60"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Контейнеры для статусов -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Первая строка статусов -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp"
                        android:gravity="center">

                        <!-- Ignition Status -->
                        <LinearLayout
                            android:id="@+id/ignitionContainer"
                            android:layout_width="150dp"
                            android:layout_height="80dp"
                            android:orientation="vertical"
                            android:background="@drawable/output_background"
                            android:padding="12dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ignition"
                                android:textColor="@color/material_dynamic_secondary60"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/ignitionStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="OFF"
                                android:textColor="@color/material_dynamic_primary60"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Starter Status -->
                        <LinearLayout
                            android:id="@+id/starterContainer"
                            android:layout_width="150dp"
                            android:layout_height="80dp"
                            android:orientation="vertical"
                            android:background="@drawable/output_background"
                            android:padding="12dp"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Starter"
                                android:textColor="@color/material_dynamic_secondary60"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/starterStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="OFF"
                                android:textColor="@color/material_dynamic_primary60"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Вторая строка статусов -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp"
                        android:gravity="center">

                        <!-- LED Status -->
                        <LinearLayout
                            android:id="@+id/ledContainer"
                            android:layout_width="150dp"
                            android:layout_height="80dp"
                            android:orientation="vertical"
                            android:background="@drawable/output_background"
                            android:padding="12dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LED"
                                android:textColor="@color/material_dynamic_secondary60"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <!-- Контейнер для статуса LED и индикатора -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:layout_marginTop="4dp">

                                <TextView
                                    android:id="@+id/ledStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="OFF"
                                    android:textColor="@color/material_dynamic_primary60"
                                    android:textSize="14sp" />

                                <ImageView
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginStart="4dp"
                                    android:src="@drawable/connection_indicator"
                                    android:tint="@android:color/holo_purple"/>

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(hold to set color)"
                                android:textColor="@color/material_dynamic_secondary60"
                                android:textSize="8sp"
                                android:textStyle="italic"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Voltage Status -->
                        <LinearLayout
                            android:layout_width="150dp"
                            android:layout_height="80dp"
                            android:orientation="vertical"
                            android:background="@drawable/output_background"
                            android:padding="12dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Voltage"
                                android:textColor="@color/material_dynamic_secondary60"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/voltageStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0V"
                                android:textColor="@color/material_dynamic_primary60"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Третья строка статусов -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Engine Temp Status -->
                        <LinearLayout
                            android:layout_width="150dp"
                            android:layout_height="80dp"
                            android:orientation="vertical"
                            android:background="@drawable/output_background"
                            android:padding="12dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Engine Temp"
                                android:textColor="@color/material_dynamic_secondary60"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/engineTempStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0°C"
                                android:textColor="@color/material_dynamic_primary60"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Street Temp Status -->
                        <LinearLayout
                            android:layout_width="150dp"
                            android:layout_height="80dp"
                            android:orientation="vertical"
                            android:background="@drawable/output_background"
                            android:padding="12dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Street Temp"
                                android:textColor="@color/material_dynamic_secondary60"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/streetTempStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0°C"
                                android:textColor="@color/material_dynamic_primary60"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="308dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/output_background"
                    android:padding="15dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fuel level"
                        android:textColor="@color/material_dynamic_secondary60"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fuelLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:textColor="@color/material_dynamic_primary60"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>