<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="15dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Кнопка Back -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/aboutBackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:drawableLeft="@drawable/ic_arrow_backward"
                android:textColor="?attr/colorPrimary"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="?attr/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp"
                android:layout_centerInParent="true" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_settings"
                android:layout_alignParentEnd="true"
                android:layout_marginBottom="5dp"
                android:layout_centerInParent="true"
                android:layout_marginEnd="15dp"
                android:tint="?attr/colorPrimary" />

        </RelativeLayout>

        <!-- Основной контент -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connection"
                android:textColor="@color/material_dynamic_secondary60"
                android:textSize="16sp"
                android:layout_marginBottom="10dp" />

            <!-- Контейнер устройства -->
            <LinearLayout
                android:id="@+id/deviceInfoContainer"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/output_background"
                android:padding="16dp"
                android:layout_marginBottom="15dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device"
                    android:textColor="@color/material_dynamic_primary60"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/deviceInfoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No device selected"
                    android:textColor="@color/material_dynamic_primary60"
                    android:textSize="14sp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Контейнер PIN-кода -->
            <LinearLayout
                android:id="@+id/pinInfoContainer"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/output_background"
                android:padding="16dp"
                android:layout_marginBottom="15dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PIN Code"
                    android:textColor="@color/material_dynamic_primary60"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/pinInfoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="••••"
                    android:textColor="@color/material_dynamic_primary60"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(clickable)"
                    android:textColor="@color/material_dynamic_secondary60"
                    android:textSize="10sp"
                    android:textStyle="bold|italic"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device actions"
                android:textColor="@color/material_dynamic_secondary60"
                android:textSize="16sp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp">

            <!-- Кнопка смены PIN -->
            <Button
                android:id="@+id/changePinButton"
                android:layout_width="160dp"
                android:layout_height="60dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="?attr/colorPrimary"
                android:text="Change PIN"
                android:textColor="@color/material_dynamic_neutral_variant10"
                app:cornerRadius="12dp"
                android:drawableLeft="@drawable/ic_pin"
                android:drawableTint="@color/material_dynamic_neutral_variant10" />

            <!-- Кнопка синхронизации времени -->
            <Button
                android:id="@+id/syncTimeButton"
                android:layout_width="160dp"
                android:layout_height="60dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="?attr/colorPrimary"
                android:text="Sync Time"
                android:textColor="@color/material_dynamic_neutral_variant10"
                app:cornerRadius="12dp"
                android:drawableLeft="@drawable/ic_sync"
                android:drawableTint="@color/material_dynamic_neutral_variant10" />

            </LinearLayout>

            <!-- Секция управления картами -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cards"
                android:textColor="@color/material_dynamic_secondary60"
                android:textSize="16sp"
                android:layout_marginBottom="10dp" />

            <!-- Кнопки управления картами -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp">

                <Button
                    android:id="@+id/listCardsButton"
                    android:layout_width="160dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:text="List cards"
                    android:textColor="@color/material_dynamic_neutral_variant10"
                    app:cornerRadius="12dp"
                    android:drawableLeft="@drawable/ls"
                    android:drawableTint="@color/material_dynamic_neutral_variant10" />

                <Button
                    android:id="@+id/addCardButton"
                    android:layout_width="160dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:text="Add card"
                    android:textColor="@color/material_dynamic_neutral_variant10"
                    app:cornerRadius="12dp"
                    android:drawableLeft="@drawable/add"
                    android:drawableTint="@color/material_dynamic_neutral_variant10" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset"
                android:textColor="@color/material_dynamic_secondary60"
                android:textSize="16sp"
                android:layout_marginBottom="10dp" />

            <!-- Кнопка сброса -->
            <Button
                android:id="@+id/factoryResetButton"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="?attr/colorPrimary"
                android:text="Reset Settings"
                android:textColor="@color/material_dynamic_neutral_variant10"
                app:cornerRadius="12dp"
                android:drawableLeft="@drawable/ic_reset"
                android:layout_marginBottom="15dp"
                android:drawableTint="@color/material_dynamic_neutral_variant10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About ⓘ"
                android:textColor="@color/material_dynamic_secondary60"
                android:textSize="16sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UniStart v4.0"
                android:textSize="12sp"
                android:textColor="@color/material_dynamic_primary60"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Developed by nsline22"
                android:textSize="12sp"
                android:textColor="@color/material_dynamic_primary60"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/signlink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="t.me/nsline22"
                android:autoLink="web"
                android:linksClickable="true"
                android:textColorLink="@color/material_dynamic_primary50"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>