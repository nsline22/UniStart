<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Nsline22" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/material_dynamic_neutral_variant10</item>
        <item name="colorPrimary">@color/material_dynamic_primary70</item>
        <item name="editTextStyle">@style/EditTextStyle</item>
        <item name="android:statusBarColor">@color/material_dynamic_neutral_variant10</item>
        <item name="android:navigationBarColor">@color/material_dynamic_neutral_variant10</item>
    </style>

    <style name="Theme.Nsline22.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="colorPrimary">@color/material_dynamic_primary40</item>
        <item name="editTextStyle">@style/EditTextStyle.Light</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>

    <style name="Theme.Nsline22.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorPrimary">@color/material_dynamic_primary80</item>
        <item name="editTextStyle">@style/EditTextStyle.Dark</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="EditTextStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/material_dynamic_primary70</item>
        <item name="android:textColorHint">@color/material_dynamic_primary70</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="EditTextStyle.Light" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/material_dynamic_primary40</item>
        <item name="android:textColorHint">@color/material_dynamic_primary40</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="EditTextStyle.Dark" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/material_dynamic_primary80</item>
        <item name="android:textColorHint">@color/material_dynamic_primary80</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="ScrollViewStyle" parent="android:Widget.ScrollView">
        <item name="android:overScrollMode">always</item>
        <item name="android:scrollbarStyle">insideOverlay</item>
        <item name="android:fadeScrollbars">false</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
    </style>

    <style name="Theme.Nsline22.Legacy" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background_dark_legacy</item>
        <item name="colorPrimary">@color/primary_legacy</item>
        <item name="colorPrimaryVariant">@color/primary_variant_legacy</item>
        <item name="colorOnPrimary">@color/on_primary_legacy</item>
        <item name="colorSecondary">@color/secondary_legacy</item>
        <item name="colorSecondaryVariant">@color/secondary_variant_legacy</item>
        <item name="colorOnSecondary">@color/on_secondary_legacy</item>
        <item name="android:statusBarColor">@color/background_dark_legacy</item>
        <item name="android:navigationBarColor">@color/background_dark_legacy</item>
    </style>

    <!-- EditText стили для legacy -->
    <style name="EditTextStyle.Legacy" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_legacy</item>
        <item name="android:textColorHint">@color/primary_legacy</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>